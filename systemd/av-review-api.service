[Unit]
Description=findav av_review LAN API (health + trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yuanhao/av-review
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/yuanhao/av-review/bin/av_review api --host 0.0.0.0 --port 18765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
